{
    "name": "springy-framework/brazilian-numbers",
    "description": "PHP class for validate and check brazilian document and numbers",
    "license": "MIT",
    "type": "library",
    "keywords": [""],
    "authors": [
        {
            "name": "Fernando Val",
            "homepage": "https://fval.com.br",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/springy-framework/brazilian-numbers",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.0",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "@stable"
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "psr-4": {
           "Springy\\Utils\\BrazilianNumbers\\": "src/"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=PSR12 -n src",
        "phpcbf" : "phpcbf --standard=PSR12 -n src",
        "phpmd" : "phpmd src html codesize.xml > phpmd.html",
        "unit": "phpunit",
        "phpstan": "phpstan analyse src --level 0",
        "test": [
            "@phpcs",
            "@phpcbf",
            "@phpmd",
            "@unit",
            "@phpstan"
        ]
    }
}